{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__p=$1" },
    { "source": "/a/(.*)", "destination": "/api/index?__p=a/$1" }
  ],
  "headers": [
    { "source": "/a/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
